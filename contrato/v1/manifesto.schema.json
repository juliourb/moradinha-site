{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://moradinha/contrato/v1/manifesto.schema.json",
  "title": "manifesto.json",
  "type": "object",
  "required": [
    "contrato", "conjunto_id", "nome", "edicao", "commit_completo",
    "data_execucao", "publico", "h3_resolucao", "centro", "zoom_inicial",
    "periodos", "componentes", "regime_mapa", "recortes", "arquivos"
  ],
  "additionalProperties": false,
  "properties": {
    "contrato": { "const": "1.0" },
    "conjunto_id": { "type": "string", "minLength": 1 },
    "nome": { "type": "string", "minLength": 1 },
    "edicao": { "type": "string", "minLength": 1 },
    "commit_completo": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "data_execucao": { "type": "string", "format": "date-time" },
    "publico": { "type": "boolean" },
    "ficticio": { "type": "boolean" },
    "h3_resolucao": { "const": 8 },
    "centro": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": { "type": "number" }
    },
    "zoom_inicial": { "type": "number" },
    "contornos_tolerancia_m": { "type": "number" },
    "d17_conferido": { "type": "boolean" },
    "periodos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "rotulo", "tipo", "anos", "fonte_estoque", "marcas"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "rotulo": { "type": "string" },
          "tipo": { "enum": ["ano", "media"] },
          "anos": { "type": "array", "items": { "type": "integer" }, "minItems": 1 },
          "fonte_estoque": { "type": "string" },
          "marcas": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "componentes": {
      "type": "array",
      "items": { "enum": ["coabitacao", "onus", "precariedade"] },
      "minItems": 3,
      "maxItems": 3
    },
    "regime_mapa": { "const": "c" },
    "recortes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "nome", "motivo", "fonte"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "nome": { "type": "string" },
          "motivo": { "type": "string" },
          "fonte": { "type": "string" }
        }
      }
    },
    "arquivos": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    }
  }
}
